{
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "serviceAccountKey.json", "set-admin.js", "package.json", "package-lock.json"],
    "headers": [{"source":"**/*.@(js|css)","headers":[{"key":"Cache-Control","value":"public,max-age=3600"}]}]
  }
}

